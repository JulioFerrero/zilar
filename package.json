{
  "name": "zilar",
  "private": true,
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@10.32.1",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "typecheck": "turbo typecheck",
    "lint": "oxlint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "turbo test",
    "infra:up": "docker compose -f infra/docker-compose.dev.yml --env-file infra/.env up -d --wait",
    "infra:down": "docker compose -f infra/docker-compose.dev.yml --env-file infra/.env down",
    "infra:logs": "docker compose -f infra/docker-compose.dev.yml --env-file infra/.env logs -f",
    "infra:reset": "node infra/reset.mjs",
    "infra:smoke": "pnpm --filter @zilar/devtools smoke",
    "xmpp:e2e": "pnpm --filter @zilar/devtools xmpp:e2e",
    "effect:map": "pnpm --filter @zilar/devtools effect:map",
    "lead:watch": "pnpm --filter @zilar/devtools exec tsx src/lead/cli.ts watch",
    "screenshots": "node --experimental-strip-types scripts/screenshots.ts",
    "gate": "pnpm --filter @zilar/devtools exec tsx src/gate/cli.ts --base main",
    "phone:install": "bash scripts/phone/install.sh",
    "phone:crash": "bash scripts/phone/crash.sh",
    "phone:smoke": "bash scripts/phone/smoke.sh"
  },
  "devDependencies": {
    "@types/node": "^24",
    "oxlint": "^1.85.0",
    "playwright": "^1.63.0",
    "prettier": "^3.9.9",
    "turbo": "^2.11.4",
    "typescript": "7.0.2",
    "vitest": "catalog:"
  }
}
