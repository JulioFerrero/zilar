{
  "name": "galena",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.32.1",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "typecheck": "turbo typecheck",
    "lint": "oxlint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "turbo test",
    "infra:up": "docker compose -f infra/docker-compose.dev.yml --env-file infra/.env up -d --wait",
    "infra:down": "docker compose -f infra/docker-compose.dev.yml --env-file infra/.env down",
    "infra:logs": "docker compose -f infra/docker-compose.dev.yml --env-file infra/.env logs -f",
    "infra:reset": "node infra/reset.mjs",
    "infra:smoke": "pnpm --filter @galena/devtools smoke"
  },
  "devDependencies": {
    "@types/node": "^24",
    "oxlint": "^1.85.0",
    "prettier": "^3.9.9",
    "turbo": "^2.11.4",
    "typescript": "^6.0.3",
    "vitest": "^5.0.2"
  }
}
