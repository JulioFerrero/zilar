# Galena local development environment.
#
# Copy this file to infra/.env and replace every CHANGE_ME value:
#
#   cp infra/.env.example infra/.env
#
# infra/.env is git-ignored. Never commit real values.
# Use URL-safe passwords (letters, digits, "-", "_", ".") because some of them
# are embedded in Postgres connection URLs.

# Superuser of the Postgres container. Only used inside the container and by
# infra/postgres/init/10-create-databases.sql; apps use the users below.
POSTGRES_PASSWORD=CHANGE_ME

# User "galena" and database "galena": our server's database (pgvector enabled).
GALENA_DB_PASSWORD=CHANGE_ME

# User "ejabberd" and database "ejabberd": XMPP accounts, rosters, MUC and MAM.
EJABBERD_DB_PASSWORD=CHANGE_ME

# User "litellm" and database "litellm": LiteLLM keys, budgets and spend logs.
LITELLM_DB_PASSWORD=CHANGE_ME

# Password of the XMPP admin account admin@galena.localhost. The container
# registers the account on first start; pnpm infra:smoke uses it for the admin API.
EJABBERD_ADMIN_PASSWORD=CHANGE_ME

# Bare JID of that same admin account. @galena/server uses it to call ejabberd's
# admin API, and pnpm xmpp:e2e reads it from here.
EJABBERD_ADMIN_JID=admin@galena.localhost

# Shared HS256 secret for XMPP token login, at least 32 random bytes. The
# ejabberd container turns it into a JWK file at start and @galena/server signs
# short-lived JWTs with it. Generate one with e.g. "openssl rand -base64 48".
GALENA_XMPP_JWT_SECRET=CHANGE_ME

# LiteLLM proxy master key: the Bearer token for its admin API. It normally
# looks like "sk-...". Changing it later needs a volume reset to stay consistent
# with the keys already stored in the database.
LITELLM_MASTER_KEY=sk-CHANGE_ME

# API key for the placeholder model in infra/litellm/config.yaml. Keep a fake
# value here; add real provider keys as extra variables only when you add real
# models that use them.
PLACEHOLDER_API_KEY=CHANGE_ME