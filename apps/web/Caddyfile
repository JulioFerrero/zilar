# Zilar production web app: static file server with SPA fallback.
#
# Serves the built Vite app, and forwards the API (`/api/*`), the XMPP
# WebSocket (`/xmpp-ws/ws` only: every other `/xmpp-ws/*` path answers 404
# so ejabberd's admin REST API is never public) and uploads (`/upload/*`)
# to the server and ejabberd.
# deploy/docker-compose.yml routes those paths before they reach this
# service; deploy/coolify/docker-compose.yml relies on the forwarding below.

{
  admin off
  # Trust the private-range proxy in front (Traefik on Coolify), so its X-Forwarded-For is kept and our peer appended instead of replacing it.
  servers {
    trusted_proxies static private_ranges
  }
  # On stop, close open WebSockets after 2 s instead of waiting forever (deploys were force-killed at 30 s).
  grace_period 2s
}

:80 {
  root * /srv/zilar-web

  # Security headers on every response.
  header {
    X-Content-Type-Options nosniff
    Referrer-Policy strict-origin-when-cross-origin
    # Same-origin API, the XMPP WebSocket, images/uploads: nothing needs a
    # cross-origin frame, script, worker or connect target. `blob:` is needed
    # for voice-message playback and attachment previews
    # (apps/web/src/lib/attachments.ts); `data:` for inline avatar images.
    Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https:; media-src 'self' blob: https:; connect-src 'self' wss: ws:; font-src 'self' data:; worker-src 'self' blob:; frame-ancestors 'none'; base-uri 'self'; form-action 'self'"
    # Remove the Server version banner.
    -Server
  }

  # Vite emits hashed filenames under /assets: cache them for a year.
  @hashed path /assets/*
  header @hashed Cache-Control "public, max-age=31536000, immutable"

  # Never cache the entry point: index.html references the hashed assets.
  @entry file /srv/zilar-web/index.html
  handle @entry {
    header Cache-Control "no-store"
  }

  # Behind a proxy that routes these paths itself (Caddy in deploy/docker-compose.yml)
  # they never arrive here. Behind a proxy that only knows one domain per service
  # (Coolify), this makes the web container the single entry point. Hosts resolve
  # when a request arrives, so the plain stack never needs them from here.
  handle /api/* {
    reverse_proxy server:3000 {
      lb_try_duration 30s
      lb_try_interval 250ms
    }
  }

  handle /health {
    reverse_proxy server:3000 {
      lb_try_duration 30s
      lb_try_interval 250ms
    }
  }

  handle /xmpp-ws/ws {
    uri strip_prefix /xmpp-ws
    reverse_proxy ejabberd:5280 {
      lb_try_duration 30s
      lb_try_interval 250ms
    }
  }

  # Everything else under /xmpp-ws is not the WebSocket: ejabberd's :5280
  # listener also serves its admin REST API at /api (mod_http_api), so those
  # paths answer 404 instead of reaching it (SEC-2).
  handle /xmpp-ws/* {
    respond 404
  }

  handle /upload/* {
    # Uploaded files are served straight from ejabberd: no MIME sniffing,
    # no script execution from them, HSTS like everywhere else (F1).
    header {
      X-Content-Type-Options nosniff
      Content-Security-Policy "default-src 'none'; sandbox"
      Strict-Transport-Security "max-age=31536000; includeSubDomains"
    }
    reverse_proxy ejabberd:5280 {
      lb_try_duration 30s
      lb_try_interval 250ms
    }
  }

  # The one-line installer (`curl -fsSL https://get.zilar.app | sh`). The
  # script is copied into the image by the Dockerfile (deploy/install.sh).
  handle /install.sh {
    header Content-Type "text/x-shellscript; charset=utf-8"
    header Cache-Control "no-cache"
    file_server
  }

  # The bare installer host answers with the script at any path, so
  # https://get.zilar.app and https://get.zilar.app/anything both work.
  @installer host get.zilar.app
  handle @installer {
    rewrite * /install.sh
    header Content-Type "text/x-shellscript; charset=utf-8"
    header Cache-Control "no-cache"
    file_server
  }

  handle {
    # SPA fallback: every non-file path serves index.html.
    try_files {path} /index.html
    file_server
  }
}
