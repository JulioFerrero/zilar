# Galena production web app: static file server with SPA fallback.
#
# The API (`/api/*`), the XMPP WebSocket (`/xmpp-ws/*`) and uploads
# (`/upload/*`) are NOT served here: the production reverse proxy (Caddy in
# deploy/docker-compose.yml, Traefik in deploy/coolify/docker-compose.yml)
# routes those paths to the server and ejabberd before they reach this
# service. This file only serves the built Vite app.

{
  admin off
}

:80 {
  root * /srv/galena-web

  # Security headers on every response.
  header {
    X-Content-Type-Options nosniff
    Referrer-Policy strict-origin-when-cross-origin
    # Same-origin API, the XMPP WebSocket, images/uploads: nothing needs a
    # cross-origin frame, script, worker or connect target. `blob:` is needed
    # for voice-message playback and attachment previews
    # (apps/web/src/lib/attachments.ts); `data:` for inline avatar images.
    Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https:; media-src 'self' blob: https:; connect-src 'self' wss: ws:; font-src 'self' data:; worker-src 'self' blob:; frame-ancestors 'none'; base-uri 'self'; form-action 'self'"
    # Remove the Server version banner.
    -Server
  }

  # Vite emits hashed filenames under /assets: cache them for a year.
  @hashed path /assets/*
  header @hashed Cache-Control "public, max-age=31536000, immutable"

  # Never cache the entry point: index.html references the hashed assets.
  @entry file /srv/galena-web/index.html
  handle @entry {
    header Cache-Control "no-store"
  }

  # SPA fallback: every non-file path serves index.html.
  try_files {path} /index.html
  file_server
}
