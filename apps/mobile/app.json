{
  "expo": {
    "name": "Zilar",
    "slug": "zilar",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "zilar",
    "userInterfaceStyle": "dark",
    "ios": {
      "bundleIdentifier": "app.zilar.chat"
    },
    "android": {
      "package": "app.zilar.chat",
      "permissions": ["android.permission.REQUEST_INSTALL_PACKAGES"],
      "adaptiveIcon": {
        "backgroundColor": "#0a0a0a",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": true,
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "category": ["BROWSABLE", "DEFAULT"],
          "data": [
            { "scheme": "https", "host": "chat.zilar.app", "pathPrefix": "/c/" },
            { "scheme": "https", "host": "chat.zilar.app", "pathPrefix": "/invite/" },
            { "scheme": "https", "host": "chat.zilar.app", "pathPrefix": "/j/" },
            { "scheme": "https", "host": "chat.zilar.app", "pathPrefix": "/u/" },
            { "scheme": "https", "host": "chat.zilar.app", "pathPrefix": "/settings/" },
            { "scheme": "https", "host": "chat.zilar.app", "pathPrefix": "/stickers/" },
            { "scheme": "https", "host": "chat.zilar.app", "pathPrefix": "/@" },
            { "scheme": "https", "host": "chat.zilar.app", "path": "/" }
          ]
        }
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#000000",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 140
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Zilar to access your photos to attach them to chats.",
          "cameraPermission": "Allow Zilar to access your camera to take photos to attach to chats."
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "Allow Zilar to access your microphone to record voice messages."
        }
      ],
      [
        "expo-media-library",
        {
          "savePhotosPermission": "Zilar saves photos you choose to your gallery.",
          "granularPermissions": ["photo", "video"]
        }
      ],
      "expo-notifications"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
