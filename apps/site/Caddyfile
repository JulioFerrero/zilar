# Static server for the Zilar landing page (apps/site). Coolify terminates TLS in
# front of this container, so it serves plain HTTP on port 80.
{
  auto_https off
  admin off
}

:80 {
  # The bare installer host redirects to the one-line installer attached to the
  # latest GitHub Release, at any path, so https://get.zilar.app and
  # https://get.zilar.app/anything both work. It is not part of the www redirect
  # below. The release asset is uploaded by images.yml on a version tag (T-1607),
  # so the served script always matches the newest images with no landing redeploy.
  @installer host get.zilar.app
  handle @installer {
    header Cache-Control "no-cache"
    redir https://github.com/JulioFerrero/zilar/releases/latest/download/install.sh 302
  }

  # The landing's own hosts redirect /install.sh the same way.
  handle /install.sh {
    header Cache-Control "no-cache"
    redir https://github.com/JulioFerrero/zilar/releases/latest/download/install.sh 302
  }

  # www is the main address: the bare domain redirects to it (Traefik already
  # terminated TLS for both names).
  @apex host zilar.app
  redir @apex https://www.zilar.app{uri} permanent

  root * /srv/zilar-site
  encode zstd gzip

  header {
    X-Content-Type-Options "nosniff"
    Referrer-Policy "strict-origin-when-cross-origin"
    X-Frame-Options "DENY"
    Permissions-Policy "camera=(), microphone=(), geolocation=()"
  }

  # Hashed build assets never change: cache them for a year. The page itself revalidates.
  @assets path /_next/static/*
  header @assets Cache-Control "public, max-age=31536000, immutable"
  header /index.html Cache-Control "no-cache"

  # The static export writes /docs.html or /docs/index.html, so resolve a clean
  # URL to the file that exists.
  try_files {path} {path}.html {path}/index.html

  file_server
}
