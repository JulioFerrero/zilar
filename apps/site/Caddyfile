# Static server for the Zilar landing page (apps/site). Coolify terminates TLS in
# front of this container, so it serves plain HTTP on port 80.
{
  auto_https off
  admin off
}

:80 {
  root * /srv/zilar-site
  encode zstd gzip

  header {
    X-Content-Type-Options "nosniff"
    Referrer-Policy "strict-origin-when-cross-origin"
    X-Frame-Options "DENY"
    Permissions-Policy "camera=(), microphone=(), geolocation=()"
  }

  # Hashed build assets never change: cache them for a year. The page itself revalidates.
  @assets path /assets/*
  header @assets Cache-Control "public, max-age=31536000, immutable"
  header /index.html Cache-Control "no-cache"

  file_server
}
