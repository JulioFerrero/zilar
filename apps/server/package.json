{
  "name": "@zilar/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/index.ts",
    "invite:create": "tsx --env-file-if-exists=.env src/auth/invite-cli.ts",
    "build": "node build.mjs",
    "start": "node --enable-source-maps dist/index.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --testTimeout=30000 --hookTimeout=30000",
    "db:migrate": "tsx --env-file-if-exists=.env src/db/migrate-cli.ts"
  },
  "dependencies": {
    "@effect/platform-node": "4.0.2",
    "@effect/sql-pg": "4.0.2",
    "@types/web-push": "^3.6.4",
    "@xmpp/client": "catalog:",
    "@xmpp/component": "^0.14.0",
    "@zilar/api-contract": "workspace:*",
    "@zilar/protocol": "workspace:*",
    "@zilar/runner-tunnel": "workspace:*",
    "@zilar/xmpp-core": "workspace:*",
    "better-auth": "catalog:",
    "effect": "catalog:",
    "jose": "^6.2.12",
    "nodemailer": "^10.0.12",
    "pino": "^10.3.1",
    "postgres": "^3.4.9",
    "quickjs-emscripten": "^0.32.0",
    "web-push": "^3.6.7",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@effect/sql-pglite": "4.0.2",
    "@electric-sql/pglite": "^0.5.8",
    "@types/nodemailer": "^8.0.2",
    "esbuild": "0.28.2",
    "pino-pretty": "^13.1.3",
    "tsx": "catalog:"
  }
}
