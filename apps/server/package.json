{
  "name": "@zilar/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/index.ts",
    "invite:create": "tsx --env-file-if-exists=.env src/auth/invite-cli.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --testTimeout=30000 --hookTimeout=30000",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file-if-exists=.env src/db/migrate-cli.ts"
  },
  "dependencies": {
    "@effect/sql-pg": "4.0.2",
    "@effect/sql-pglite": "4.0.2",
    "@hono/node-server": "^2.1.1",
    "@types/web-push": "^3.6.4",
    "@xmpp/component": "^0.14.0",
    "@zilar/protocol": "workspace:*",
    "@zilar/runner-tunnel": "workspace:*",
    "@zilar/xmpp-core": "workspace:*",
    "better-auth": "^1.7.6",
    "drizzle-orm": "^0.45.3",
    "effect": "^4.0.2",
    "hono": "^4.13.9",
    "jose": "^6.2.12",
    "nodemailer": "^10.0.12",
    "pino": "^10.3.1",
    "postgres": "^3.4.9",
    "quickjs-emscripten": "^0.32.0",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@types/nodemailer": "^8.0.2",
    "drizzle-kit": "^0.31.11",
    "pino-pretty": "^13.1.3",
    "tsx": "^4.23.15"
  }
}
