# Copy to .env and fill in real values. Never commit the filled file.

# development | test | production. Default: development.
NODE_ENV=development

# TCP port the HTTP server listens on. Default: 3000.
PORT=3000

# Postgres connection string. The password must match GALENA_DB_PASSWORD in infra/.env.
DATABASE_URL=postgres://galena:CHANGE_ME@127.0.0.1:5432/galena

# fatal | error | warn | info | debug | trace. Default: info.
LOG_LEVEL=info

# Public base URL of this server. Default: http://localhost:3000.
PUBLIC_URL=http://localhost:3000

# Secret Better Auth uses to sign sessions and encrypt data. Must be at least 32
# characters. Generate one with: openssl rand -base64 32
BETTER_AUTH_SECRET=CHANGE_ME_CHANGE_ME_CHANGE_ME_CHANGE_ME

# Base URL Better Auth uses. Defaults to PUBLIC_URL.
BETTER_AUTH_URL=http://localhost:3000

# Comma-separated list of web app origins allowed to call the API with cookies.
# Default: http://localhost:5173 (the Vite dev server).
WEB_ORIGINS=http://localhost:5173
