# Copy to .env and fill in real values. Never commit the filled file.

# development | test | production. Default: development.
NODE_ENV=development

# TCP port the HTTP server listens on. Default: 3000.
PORT=3000

# Postgres connection string. The password must match GALENA_DB_PASSWORD in infra/.env.
DATABASE_URL=postgres://galena:CHANGE_ME@127.0.0.1:5432/galena

# fatal | error | warn | info | debug | trace. Default: info.
LOG_LEVEL=info

# Public base URL of this server. Default: http://localhost:3000.
PUBLIC_URL=http://localhost:3000
