# Copy to .env and fill in real values. Never commit the filled file.

# development | test | production. Default: development.
NODE_ENV=development

# TCP port the HTTP server listens on. Default: 3000.
PORT=3000

# Postgres connection string. The password must match ZILAR_DB_PASSWORD in infra/.env.
DATABASE_URL=postgres://zilar:CHANGE_ME@127.0.0.1:5432/zilar

# fatal | error | warn | info | debug | trace. Default: info.
LOG_LEVEL=info

# Public base URL of this server. Default: http://localhost:3000.
PUBLIC_URL=http://localhost:3000

# Secret Better Auth uses to sign sessions and encrypt data. Must be at least 32
# characters. Generate one with: openssl rand -base64 32
BETTER_AUTH_SECRET=CHANGE_ME_CHANGE_ME_CHANGE_ME_CHANGE_ME

# Base URL Better Auth uses. Defaults to PUBLIC_URL.
BETTER_AUTH_URL=http://localhost:3000

# Comma-separated list of web app origins allowed to call the API with cookies.
# Default: http://localhost:5173 (the Vite dev server).
WEB_ORIGINS=http://localhost:5173

# ejabberd admin API used to create XMPP accounts. Default: http://127.0.0.1:5280/api.
EJABBERD_API_URL=http://127.0.0.1:5280/api

# Bare JID of the ejabberd admin account that owns the API calls.
EJABBERD_ADMIN_JID=admin@zilar.localhost

# Password of that admin account. Must match EJABBERD_ADMIN_PASSWORD in infra/.env.
EJABBERD_ADMIN_PASSWORD=CHANGE_ME

# XMPP domain users are registered on. Default: zilar.localhost.
XMPP_DOMAIN=zilar.localhost

# XMPP MUC (group chat) domain. Default: rooms.zilar.localhost.
XMPP_MUC_DOMAIN=rooms.zilar.localhost

# Public WebSocket URL clients connect to. Default: ws://127.0.0.1:5280/ws.
XMPP_WS_PUBLIC_URL=ws://127.0.0.1:5280/ws

# Shared secret for signing XMPP login JWTs. Must be at least 32 characters and
# must match ZILAR_XMPP_JWT_SECRET in infra/.env. Generate with: openssl rand -base64 32
ZILAR_XMPP_JWT_SECRET=CHANGE_ME_CHANGE_ME_CHANGE_ME_CHANGE_ME

# Agent gateway (T-0034): keep every active AI online over XMPP and reply to
# owner DMs. Off by default; set to true to enable. Needs LITELLM_BASE_URL,
# LITELLM_MASTER_KEY and ZILAR_KEY_ENCRYPTION_KEY to do anything.
AGENT_GATEWAY_ENABLED=false

# Action demo adapter (T-0093): registers the harmless `demo.echo` adapter so
# a DM owner can prove the `request_action` tool end-to-end. Off by default;
# set to true to enable. Production behaviour is unchanged when false.
ACTION_DEMO_ENABLED=false
