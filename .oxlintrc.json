{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["eslint", "unicorn", "oxc", "typescript", "react"],
  "categories": {
    "correctness": "error"
  },
  "env": {
    "builtin": true,
    "browser": true,
    "node": true
  },
  "overrides": [
    {
      "files": ["apps/mobile/src/app/**/*.tsx"],
      "rules": {
        "react/rules-of-hooks": "error"
      }
    }
  ],
  "ignorePatterns": ["dist", "coverage", ".turbo"]
}
