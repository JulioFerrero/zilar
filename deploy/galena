#!/bin/sh
#
# galena — install helper for a Galena production install.
#
# Lives in deploy/ next to docker-compose.yml and .env. Single POSIX shell
# script; needs only `sh`, `openssl` and `docker` (plus the POSIX core
# tools every Linux and macOS ships: grep, sed, tar, date, mktemp).
#
#   ./galena init          write deploy/.env with generated secrets
#   ./galena up|down|logs|status|update   run the compose stack
#   ./galena doctor        check the machine before/after install
#   ./galena backup [dir]  timestamped archive (databases, uploads, .env)
#   ./galena restore <archive>   bring an install back (needs --yes)
#   ./galena create-admin  mint the invite code for the first account
#
# Global options (accepted before or after the command):
#   --env-file=PATH   use another env file (default: deploy/.env next to this script)
#   --dry-run         print what would run or be written, change nothing
#   --force, -f       let `init` overwrite an existing env file
#   --yes, -y         required by `restore`
#
# The script NEVER prints a secret: it prints file paths and value shapes
# (e.g. "<48 hex chars>"), never values. Secrets live only in the env file
# (mode 0600) and in backup archives (mode 0600, with a warning file).
#
# Exit status: 0 on success, 1 on any failure (`doctor` exits 1 when a
# check fails so it can gate scripts).

set -eu

PROG="galena"

# The deploy directory is wherever this script lives.
DEPLOY_DIR="$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)"
COMPOSE_FILE="$DEPLOY_DIR/docker-compose.yml"
DEFAULT_ENV_FILE="$DEPLOY_DIR/.env"

DRY_RUN=0
FORCE=0
YES=0
ENV_FILE=""

die() {
  echo "$PROG: error: $*" >&2
  exit 1
}

info() {
  echo "$PROG: $*"
}

need_cmd() {
  command -v "$1" >/dev/null 2>&1 || die "needs '$1' on PATH ($2)"
}

# Print the command instead of running it when --dry-run is on.
run() {
  if [ "$DRY_RUN" -eq 1 ]; then
    echo "+ $*"
  else
    "$@"
  fi
}

# Thin wrapper so every compose call uses the same file and env file.
# Extra compose flags (e.g. `galena logs --tail 20`) pass straight through.
compose() {
  if [ "$DRY_RUN" -eq 1 ]; then
    echo "+ docker compose -f $COMPOSE_FILE --env-file $ENV_FILE $*"
  else
    docker compose -f "$COMPOSE_FILE" --env-file "$ENV_FILE" "$@"
  fi
}

# Read one KEY from the env file (last occurrence wins). Values are
# machine-generated (no spaces, no quotes); surrounding double quotes are
# stripped so a hand-quoted edit still works.
env_get() {
  [ -f "$ENV_FILE" ] || return 0
  sed -n "s/^$1=//p" "$ENV_FILE" | tail -n 1 | sed 's/^"//; s/"$//'
}

require_env_file() {
  [ -f "$ENV_FILE" ] || die "no env file at $ENV_FILE — run '$PROG init' first"
}

require_docker() {
  need_cmd docker "install Docker with the Compose plugin, then retry"
  docker compose version >/dev/null 2>&1 || die "'docker compose' is missing — install the Compose plugin, then retry"
}

# Ask on the terminal (works even when stdin is piped). Prints the answer;
# empty answer falls back to the default (second argument, may be empty).
ask() {
  if [ -n "${2-}" ]; then
    printf '%s [%s]: ' "$1" "$2" >&2
  else
    printf '%s: ' "$1" >&2
  fi
  _answer=""
  # Prefer the terminal (works when stdin is piped); fall back to stdin
  # when there is no terminal (pipes, CI, non-interactive flags). The
  # probe runs in a subshell so a missing /dev/tty stays quiet.
  if ( : < /dev/tty ) 2>/dev/null; then
    IFS= read -r _answer < /dev/tty || _answer=""
  else
    IFS= read -r _answer || _answer=""
  fi
  if [ -z "$_answer" ]; then
    printf '%s' "${2-}"
  else
    printf '%s' "$_answer"
  fi
}

usage() {
  cat <<EOF
Usage: $PROG [--env-file=PATH] [--dry-run] <command> [args]

  init [--domain D] [--admin-email E] [--acme-email E]
       [--image-owner O] [--image-tag T] [--http-port P] [--https-port P] [--force]
      Generate every secret and write the env file (0600). Refuses to
      overwrite an existing file unless --force is given.
  up [compose args]       Start the stack and wait until it is healthy.
  down [compose args]     Stop the stack (data volumes are kept).
  logs [compose args]     Follow the service logs (default: -f).
  status                  Show container and health status.
  update                  Pull images, restart, wait until healthy.
  doctor                  Check Docker, ports, DNS and /health with fix hints.
  backup [dir]            Write a timestamped archive (default dir: deploy/backups).
  restore <archive> --yes Stop services, restore databases/uploads/.env, restart.
  create-admin [--uses N] [--days D]
      Mint the invite code for the first account on the running server.

Global options can come before or after the command.
EOF
}

# --- init ---------------------------------------------------------------

cmd_init() {
  _domain="" _admin_email="" _acme_email="" _owner="" _tag="latest"
  _http_port="80" _https_port="443"

  _args_total=$#
  while [ $# -gt 0 ]; do
    case "$1" in
      --domain=*|--admin-email=*|--acme-email=*|--image-owner=*|--image-tag=*|--http-port=*|--https-port=*)
        _opt="${1%%=*}"; _val="${1#*=}"
        shift
        ;;
      --domain|--admin-email|--acme-email|--image-owner|--image-tag|--http-port|--https-port)
        _opt="$1"
        [ "$#" -ge 2 ] || die "init: $1 needs a value (hint: $1=value)"
        _val="$2"; shift 2
        ;;
      *) die "init: unknown option '$1' (see '$PROG init' usage above)" ;;
    esac
    case "$_opt" in
      --domain) _domain="$_val" ;;
      --admin-email) _admin_email="$_val" ;;
      --acme-email) _acme_email="$_val" ;;
      --image-owner) _owner="$_val" ;;
      --image-tag) _tag="$_val" ;;
      --http-port) _http_port="$_val" ;;
      --https-port) _https_port="$_val" ;;
    esac
  done
  [ "$_args_total" -ge 0 ]

  need_cmd openssl "install OpenSSL, then retry"

  if [ -f "$ENV_FILE" ] && [ "$FORCE" -eq 0 ]; then
    die "$ENV_FILE already exists — remove it or re-run with --force to regenerate everything"
  fi

  [ -n "$_domain" ] || _domain="$(ask "Public domain of this install (localhost to try it out)" "localhost")"
  [ -n "$_admin_email" ] || _admin_email="$(ask "Your email address (the first account signs up with it)" "")"
  [ -n "$_acme_email" ] || _acme_email="$(ask "Email for the Let's Encrypt account" "$_admin_email")"
  [ -n "$_owner" ] || _owner="$(ask "GitHub owner that publishes the images (ghcr.io/<owner>/galena-*)" "")"
  _tag="${_tag:-latest}"

  case "$_domain" in
    ""|*"://"*|*"/"*|*" "*) die "init: bad domain '$_domain' — give a bare host like chat.example.com" ;;
  esac
  case "$_admin_email" in
    *"@"*.*) ;;
    *) die "init: bad admin email '$_admin_email' (hint: --admin-email you@example.com)" ;;
  esac
  case "$_acme_email" in
    *"@"*.*) ;;
    *) die "init: bad ACME email '$_acme_email' (hint: --acme-email you@example.com)" ;;
  esac
  [ -n "$_owner" ] || die "init: the image owner is required (hint: --image-owner <github-org>)"
  case "$_http_port$_https_port" in
    *[!0-9]*) die "init: ports must be numbers" ;;
  esac

  # The server image ships no dev-only packages (no pino-pretty), so even a
  # localhost trial runs NODE_ENV=production. The trial keeps the console
  # mailer through MAIL_ALLOW_CONSOLE_IN_PRODUCTION (OTP codes go to the
  # server log with a loud warning): scratch-only, never for a real
  # install. A real install runs production + SMTP (see
  # docs/INSTALL_DOCKER.md "Email (required)").
  if [ "$_domain" = "localhost" ]; then
    _node_env="production"
    _mail_transport="console"
    _console_in_prod="true"
  else
    _node_env="production"
    _mail_transport="smtp"
    _console_in_prod="false"
  fi

  # Every secret comes from openssl; nothing is printed, ever.
  _postgres_pw="$(openssl rand -hex 24)"
  _galena_pw="$(openssl rand -hex 24)"
  _ejabberd_pw="$(openssl rand -hex 24)"
  _archive_pw="$(openssl rand -hex 24)"
  _ejabberd_admin_pw="$(openssl rand -hex 24)"
  _jwt_secret="$(openssl rand -base64 48)"
  _auth_secret="$(openssl rand -base64 32)"
  _key_enc_key="$(openssl rand -base64 48)"

  if [ "$DRY_RUN" -eq 1 ]; then
    cat <<EOF
+ would write $ENV_FILE (mode 0600) with:
+   GALENA_DOMAIN=$_domain, ACME_EMAIL set, HTTP_PORT=$_http_port, HTTPS_PORT=$_https_port
+   NODE_ENV=$_node_env, MAIL_TRANSPORT=$_mail_transport
+   (localhost trial: MAIL_ALLOW_CONSOLE_IN_PRODUCTION=true so the console
+    mailer boots in production; OTP codes go to the server log. Real
+    installs get false and must fill SMTP_* below.)
+   MAIL_FROM=Galena <no-reply@$_domain>
+   IMAGE_OWNER=$_owner, IMAGE_TAG=$_tag
+   5 generated passwords (<48 hex chars> each: POSTGRES, GALENA_DB,
+     EJABBERD_DB, GALENA_ARCHIVE_DB, EJABBERD_ADMIN)
+   3 generated secrets (base64: XMPP_JWT <64 chars>, BETTER_AUTH <44 chars>,
+     KEY_ENCRYPTION <64 chars>)
+   feature flags all false (gateway, tools, routines, push, runner hub)
+ secrets would NOT be printed — they would live only in $ENV_FILE
EOF
    [ "$_node_env" = "production" ] && echo "+ (production:) fill SMTP_HOST/SMTP_USER/SMTP_PASSWORD in $ENV_FILE before 'up'"
    return 0
  fi

  # Compose has no way to say "unset when empty": it substitutes an empty
  # string, and zod's .optional() rejects empty strings. So for a console
  # trial the optional-but-empty SMTP lines are simply absent; a real
  # install adds them back when it switches MAIL_TRANSPORT to smtp.
  if [ "$_mail_transport" = "console" ]; then
    _smtp_lines="# SMTP lines for a real install (MAIL_TRANSPORT=smtp): uncomment and fill them in:
# SMTP_HOST=
# SMTP_USER=
# SMTP_PASSWORD=
# MAIL_REPLY_TO= (optional)"
  else
    _smtp_lines="SMTP_HOST=
SMTP_USER=
SMTP_PASSWORD=
MAIL_REPLY_TO="
  fi
  cat > "$ENV_FILE" <<EOF
# Galena install env, written by '$PROG init'. Contains live secrets:
# keep it private (mode 0600). Admin contact: $_admin_email.
# The first account signs up with that address (see '$PROG create-admin').
#
# Optional-but-empty SMTP lines are simply ABSENT (not "KEY="): Compose
# has no "unset when empty" and the server rejects empty strings for
# these variables, so a real install adds the SMTP_* lines back when it
# switches MAIL_TRANSPORT to smtp.

GALENA_DOMAIN=$_domain
ACME_EMAIL=$_acme_email
HTTP_PORT=$_http_port
HTTPS_PORT=$_https_port

# Server mode. The image ships no dev-only packages (no pino-pretty), so
# every install runs "production". A localhost trial keeps the console
# mailer through MAIL_ALLOW_CONSOLE_IN_PRODUCTION (OTP codes go to the
# server log with a loud warning): scratch-only, never for a real
# install, which needs MAIL_TRANSPORT=smtp below.
NODE_ENV=$_node_env

POSTGRES_PASSWORD=$_postgres_pw
IMAGE_OWNER=$_owner
IMAGE_TAG=$_tag
GALENA_DB_PASSWORD=$_galena_pw
EJABBERD_DB_PASSWORD=$_ejabberd_pw
GALENA_ARCHIVE_DB_PASSWORD=$_archive_pw
EJABBERD_ADMIN_PASSWORD=$_ejabberd_admin_pw
GALENA_XMPP_JWT_SECRET=$_jwt_secret
BETTER_AUTH_SECRET=$_auth_secret
GALENA_KEY_ENCRYPTION_KEY=$_key_enc_key

AGENT_GATEWAY_ENABLED=false
ACTION_DEMO_ENABLED=false
RUNNER_HUB_ENABLED=false

# Outgoing email: Galena signs people in with a one-time code sent by
# email. A localhost trial uses the console mailer; a real install must
# fill in the SMTP settings or the server refuses to start (production)
# or cannot send codes. See docs/INSTALL_DOCKER.md "Email (required)".
MAIL_TRANSPORT=$_mail_transport
$_smtp_lines
SMTP_PORT=587
SMTP_SECURE=false
MAIL_FROM=Galena <no-reply@$_domain>
MAIL_ALLOW_CONSOLE_IN_PRODUCTION=$_console_in_prod

PUSH_ENABLED=false
TOOLS_ENABLED=false
ROUTINES_ENABLED=false
WEB_TOOLS_ENABLED=false
EOF
  chmod 600 "$ENV_FILE"

  info "wrote $ENV_FILE (mode 0600). Secrets live only there — they are never printed."
  if [ "$_domain" != "localhost" ]; then
    echo ""
    echo "DNS: point an A record for $_domain at this host, otherwise Caddy"
    echo "cannot issue a certificate. Then fill SMTP_HOST/SMTP_USER/SMTP_PASSWORD"
    echo "in $ENV_FILE (the server cannot send sign-in codes without them)."
  fi
  echo ""
  echo "Next: $PROG up"
  echo "Then: $PROG create-admin   (sign up with $_admin_email)"
}

# --- stack commands -----------------------------------------------------

cmd_up() {
  require_env_file
  require_docker
  _domain="$(env_get GALENA_DOMAIN)"
  info "starting Galena (${_domain:-unknown domain})..."
  run compose up -d --wait "$@"
  if [ "$DRY_RUN" -eq 0 ] && [ -n "$_domain" ]; then
    _scheme="https"
    [ "$_domain" = "localhost" ] && _scheme="https (Caddy local CA — accept the warning)"
    info "up. Open ${_scheme}://$_domain, then run '$PROG create-admin' for the first account."
  fi
}

cmd_down() {
  require_env_file
  require_docker
  info "stopping Galena (data volumes are kept; add -v to wipe everything)..."
  run compose down "$@"
}

cmd_logs() {
  require_env_file
  require_docker
  if [ "$#" -eq 0 ]; then
    run compose logs -f
  else
    run compose logs "$@"
  fi
}

cmd_status() {
  require_env_file
  require_docker
  run compose ps
}

cmd_update() {
  require_env_file
  require_docker
  info "pulling the latest images for IMAGE_TAG=$(env_get IMAGE_TAG)..."
  run compose pull
  info "restarting and waiting for health..."
  run compose up -d --wait
  info "updated. Migrations run at server startup; back up first if the install matters ('$PROG backup')."
}

# --- doctor -------------------------------------------------------------

doctor_fail=0

doctor_bad() {
  doctor_fail=1
  echo "FAIL: $1" >&2
  echo "  fix: $2" >&2
}

doctor_ok() {
  echo "ok: $1"
}

cmd_doctor() {
  require_docker
  doctor_fail=0

  # 1. Docker daemon and Compose plugin.
  if _v="$(docker --version 2>/dev/null)"; then
    doctor_ok "docker ($_v)"
  else
    doctor_bad "cannot run docker" "install Docker and make sure the daemon is running"
  fi
  if _v="$(docker compose version 2>/dev/null)"; then
    doctor_ok "compose ($_v)"
  else
    doctor_bad "'docker compose' is missing" "install the Docker Compose v2 plugin"
  fi
  if command -v openssl >/dev/null 2>&1; then
    doctor_ok "openssl ($(openssl version 2>/dev/null))"
  else
    doctor_bad "openssl is missing" "install OpenSSL — '$PROG init' needs it to generate secrets"
  fi

  # 2. Ports free (best effort: ss, netstat or lsof; skip when none exist).
  if [ -f "$ENV_FILE" ]; then
    _http_port="$(env_get HTTP_PORT)"; _https_port="$(env_get HTTPS_PORT)"
    _http_port="${_http_port:-80}"; _https_port="${_https_port:-443}"
  else
    _http_port=80; _https_port=443
  fi
  _checker=""
  command -v ss >/dev/null 2>&1 && _checker="ss"
  [ -z "$_checker" ] && command -v netstat >/dev/null 2>&1 && _checker="netstat"
  [ -z "$_checker" ] && command -v lsof >/dev/null 2>&1 && _checker="lsof"
  if [ -z "$_checker" ]; then
    echo "skip: cannot check ports (no ss, netstat or lsof on PATH)"
  else
    for _p in "$_http_port" "$_https_port"; do
      _busy=0
      case "$_checker" in
        ss) ss -ltn 2>/dev/null | grep -q ":$_p " && _busy=1 ;;
        netstat) netstat -ltn 2>/dev/null | grep -q "[:.]$_p " && _busy=1 ;;
        lsof) lsof -iTCP:"$_p" -sTCP:LISTEN >/dev/null 2>&1 && _busy=1 ;;
      esac
      if [ "$_busy" -eq 1 ]; then
        doctor_bad "port $_p is already in use" "stop whatever listens on $_p, or set HTTP_PORT/HTTPS_PORT in $ENV_FILE"
      else
        doctor_ok "port $_p is free"
      fi
    done
  fi

  # 3. The domain resolves (best effort: first resolver found wins).
  if [ -f "$ENV_FILE" ]; then
    _domain="$(env_get GALENA_DOMAIN)"
    if [ -n "$_domain" ]; then
      _ips=""
      if command -v getent >/dev/null 2>&1; then
        _ips="$(getent hosts "$_domain" 2>/dev/null | awk '{print $1}' | head -n 3 | tr '\n' ' ')"
      elif command -v dig >/dev/null 2>&1; then
        _ips="$(dig +short "$_domain" 2>/dev/null | head -n 3 | tr '\n' ' ')"
      elif command -v nslookup >/dev/null 2>&1; then
        _ips="$(nslookup "$_domain" 2>/dev/null | awk '/^Address: /{print $2}' | tail -n +2 | tr '\n' ' ')"
      elif command -v host >/dev/null 2>&1; then
        _ips="$(host "$_domain" 2>/dev/null | awk '/has address/{print $4}' | tr '\n' ' ')"
      fi
      if [ -z "$_ips" ]; then
        if command -v getent >/dev/null 2>&1 || command -v dig >/dev/null 2>&1 || command -v nslookup >/dev/null 2>&1 || command -v host >/dev/null 2>&1; then
          doctor_bad "'$_domain' does not resolve" "point an A record for $_domain at this host and wait for DNS to propagate"
        else
          echo "skip: cannot check DNS (no getent, dig, nslookup or host on PATH)"
        fi
      else
        doctor_ok "'$_domain' resolves to ${_ips}(must be this machine for ACME to issue a certificate)"
      fi
    fi
  else
    echo "skip: no env file yet (run '$PROG init' first)"
  fi

  # 4. The server answers /health through the running stack.
  if [ -f "$ENV_FILE" ] && compose ps --status running server 2>/dev/null | grep -q server; then
    if compose exec -T server node /app/deploy-scripts/healthcheck.mjs 2>/dev/null; then
      doctor_ok "the server answers /health"
    else
      doctor_bad "the server does not answer /health" "run '$PROG logs server' and look for configuration or database errors"
    fi
  else
    echo "skip: the stack is not running (run '$PROG up' first)"
  fi

  if [ "$doctor_fail" -ne 0 ]; then
    die "doctor found problems (see FAIL lines above)"
  fi
  info "doctor: all checks pass"
}

# --- create-admin -------------------------------------------------------

cmd_create_admin() {
  require_env_file
  require_docker
  _uses=1 _days=7
  while [ "$#" -gt 1 ]; do
    case "$1" in
      --uses=*|--days=*)
        _opt="${1%%=*}"; _val="${1#*=}"
        shift
        ;;
      --uses|--days)
        _opt="$1"; _val="$2"; shift 2
        ;;
      *) die "create-admin: unknown option '$1'" ;;
    esac
    case "$_opt" in
      --uses) _uses="$_val" ;;
      --days) _days="$_val" ;;
    esac
  done
  [ "$#" -eq 0 ] || die "create-admin: unknown option '$1'"
  case "$_uses$_days" in
    *[!0-9]*) die "create-admin: --uses and --days must be numbers" ;;
  esac

  compose ps --status running server 2>/dev/null | grep -q server \
    || die "the server is not running — start it with '$PROG up' first"

  # Sign-up needs an invite: there is no admin-creation endpoint, the
  # invite CLI mints the code the sign-up form asks for. The inviter is
  # empty for this first code, so no contacts are linked.
  _admin_email="$(sed -n 's/^# Admin contact: //p' "$ENV_FILE" | tail -n 1)"
  _domain="$(env_get GALENA_DOMAIN)"
  info "minting one invite code (single use, 7 days)..."
  run compose exec -T server node /opt/tsx/node_modules/tsx/dist/cli.mjs src/auth/invite-cli.ts --uses "$_uses" --days "$_days"
  if [ "$DRY_RUN" -eq 0 ]; then
    echo ""
    echo "Open https://${_domain:-<domain>} and sign up${_admin_email:+ with $_admin_email}, pasting the code above."
    if [ "$(env_get MAIL_TRANSPORT)" = "console" ]; then
      echo "This install uses the console mailer: the sign-in code is printed in the server log ('$PROG logs server')."
    fi
  fi
}

# --- backup -------------------------------------------------------------

cmd_backup() {
  require_env_file
  require_docker
  _dir="${1:-$DEPLOY_DIR/backups}"
  [ -n "${2-}" ] && die "backup takes at most one argument (the directory)"

  compose ps --status running postgres 2>/dev/null | grep -q postgres \
    || die "postgres is not running — start the stack with '$PROG up' first"
  compose ps --status running ejabberd 2>/dev/null | grep -q ejabberd \
    || die "ejabberd is not running — start the stack with '$PROG up' first"

  _stamp="$(date -u +%Y%m%dT%H%M%SZ)"
  _name="galena-backup-$_stamp.tgz"
  _domain="$(env_get GALENA_DOMAIN)"

  if [ "$DRY_RUN" -eq 1 ]; then
    cat <<EOF
+ would write $_dir/$_name (mode 0600) containing:
+   galena.dump      pg_dump custom format of the Galena database
+   ejabberd.dump    pg_dump custom format of the ejabberd database
+   uploads.tgz      the ejabberd uploads volume
+   .env             a copy of $ENV_FILE (mode 0600 in the archive)
+   SECRETS_WARNING.txt   "this archive contains live secrets"
+   manifest.json    versions and provenance (domain, image tag, date)
+ databases would be dumped through the running containers; nothing else changes
EOF
    return 0
  fi

  mkdir -p "$_dir"
  _tmp="$(mktemp -d)"
  # mktemp owns the dir; remove it on failure without touching anything else.
  trap 'rm -rf "$_tmp"' EXIT

  info "dumping the Galena database..."
  compose exec -T -e PGPASSWORD="$(env_get POSTGRES_PASSWORD)" postgres \
    pg_dump -Fc -U postgres -d galena > "$_tmp/galena.dump"
  info "dumping the ejabberd database..."
  compose exec -T -e PGPASSWORD="$(env_get POSTGRES_PASSWORD)" postgres \
    pg_dump -Fc -U postgres -d ejabberd > "$_tmp/ejabberd.dump"
  info "archiving uploads..."
  compose exec -T ejabberd tar -C /opt/ejabberd -czf - upload > "$_tmp/uploads.tgz"

  cp "$ENV_FILE" "$_tmp/.env"
  chmod 600 "$_tmp/.env" "$_tmp/galena.dump" "$_tmp/ejabberd.dump" "$_tmp/uploads.tgz"
  cat > "$_tmp/SECRETS_WARNING.txt" <<EOF
This archive contains LIVE SECRETS (the .env file: database passwords,
JWT and session secrets). Anyone holding it owns this Galena install.
Store it encrypted, copy it off the machine, restrict who can read it.
EOF
  cat > "$_tmp/manifest.json" <<EOF
{
  "tool": "galena-backup-v1",
  "created_at": "$_stamp",
  "domain": "$_domain",
  "image_owner": "$(env_get IMAGE_OWNER)",
  "image_tag": "$(env_get IMAGE_TAG)",
  "databases": ["galena", "ejabberd"]
}
EOF

  tar -czf "$_dir/$_name" -C "$_tmp" galena.dump ejabberd.dump uploads.tgz .env SECRETS_WARNING.txt manifest.json
  chmod 600 "$_dir/$_name"
  trap - EXIT
  rm -rf "$_tmp"

  _size="$(du -h "$_dir/$_name" | cut -f1)"
  info "wrote $_dir/$_name ($_size, mode 0600). Copy it off the machine — a backup on the same disk is not a backup."
}

# --- restore ------------------------------------------------------------

cmd_restore() {
  require_env_file
  require_docker
  _archive="${1-}"
  [ -n "$_archive" ] || die "restore needs an archive: '$PROG restore <archive> --yes'"
  [ -f "$_archive" ] || die "no such file: $_archive"
  [ "$YES" -eq 1 ] || die "restore overwrites live data — re-run with --yes to confirm"

  if [ "$DRY_RUN" -eq 1 ]; then
    cat <<EOF
+ would: unpack $_archive to a temp dir and check manifest.json
+ would: stop server, web and ejabberd (postgres keeps running)
+ would: pg_restore --clean into the galena and ejabberd databases
+ would: restore the uploads volume, back up $ENV_FILE to $ENV_FILE.bak-<stamp>,
+        install the archived .env (mode 0600)
+ would: start everything and wait for health
EOF
    return 0
  fi

  _tmp="$(mktemp -d)"
  trap 'rm -rf "$_tmp"' EXIT
  tar -xzf "$_archive" -C "$_tmp"
  [ -f "$_tmp/manifest.json" ] && grep -q galena-backup-v1 "$_tmp/manifest.json" \
    || die "$_archive is not a galena backup (no manifest.json)"
  for _f in galena.dump ejabberd.dump uploads.tgz .env; do
    [ -f "$_tmp/$_f" ] || die "$_archive is missing $_f"
  done
  info "archive ok (backed up by $(sed -n 's/.*"created_at": "\(.*\)".*/\1/p' "$_tmp/manifest.json" | head -n 1))."

  info "stopping server, web and ejabberd (postgres keeps running)..."
  compose stop server web ejabberd
  run_postgres_ready() {
    _tries=0
    while [ "$_tries" -lt 30 ]; do
      if compose exec -T postgres pg_isready -U postgres -d postgres >/dev/null 2>&1; then
        return 0
      fi
      _tries=$((_tries + 1))
      sleep 2
    done
    die "postgres did not become ready"
  }
  run_postgres_ready

  info "restoring the Galena database..."
  compose exec -T -e PGPASSWORD="$(env_get POSTGRES_PASSWORD)" postgres \
    pg_restore -U postgres -d galena --clean --if-exists < "$_tmp/galena.dump"
  info "restoring the ejabberd database..."
  compose exec -T -e PGPASSWORD="$(env_get POSTGRES_PASSWORD)" postgres \
    pg_restore -U postgres -d ejabberd --clean --if-exists < "$_tmp/ejabberd.dump"

  info "starting ejabberd so uploads can be restored..."
  compose up -d ejabberd
  info "restoring uploads..."
  compose exec -T ejabberd tar -C /opt/ejabberd -xzf - upload < "$_tmp/uploads.tgz"

  _stamp="$(date -u +%Y%m%dT%H%M%SZ)"
  if [ -f "$ENV_FILE" ]; then
    cp "$ENV_FILE" "$ENV_FILE.bak-$_stamp"
    chmod 600 "$ENV_FILE.bak-$_stamp"
    info "backed up the current env file to $ENV_FILE.bak-$_stamp"
  fi
  cp "$_tmp/.env" "$ENV_FILE"
  chmod 600 "$ENV_FILE"
  info "installed the archived .env (mode 0600)."

  trap - EXIT
  rm -rf "$_tmp"

  info "starting everything and waiting for health..."
  compose up -d --wait
  info "restored. Check '$PROG status' and sign in to confirm your data is back."
}

# --- dispatch -----------------------------------------------------------

# Quote one argument for eval-safe reassembly of $@ below.
_quote() {
  printf "'%s'" "$(printf '%s' "$1" | sed "s/'/'\\\\''/g")"
}

# Globals first (accepted anywhere on the line): strip them out of $@,
# leaving only the command and its arguments.
CMD=""
_saved=""
for _a in "$@"; do
  case "$_a" in
    --dry-run) DRY_RUN=1 ;;
    --yes|-y) YES=1 ;;
    --force|-f) FORCE=1 ;;
    --env-file=*) ENV_FILE="${_a#--env-file=}" ;;
    *)
      if [ -z "$CMD" ]; then
        CMD="$_a"
      else
        _saved="$_saved $(_quote "$_a")"
      fi
      ;;
  esac
done
[ -n "$ENV_FILE" ] || ENV_FILE="$DEFAULT_ENV_FILE"
# Rebuild $@ from the saved (quoted) arguments.
# shellcheck disable=SC2086
eval "set -- $_saved"

case "$CMD" in
  ""|-h|--help|help) usage; exit 0 ;;
  init) cmd_init "$@" ;;
  up) cmd_up "$@" ;;
  down) cmd_down "$@" ;;
  logs) cmd_logs "$@" ;;
  status) cmd_status "$@" ;;
  update) cmd_update "$@" ;;
  doctor) cmd_doctor "$@" ;;
  backup) cmd_backup "$@" ;;
  restore) cmd_restore "$@" ;;
  create-admin) cmd_create_admin "$@" ;;
  *) die "unknown command '$CMD' (try '$PROG --help')" ;;
esac
