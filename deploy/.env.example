# Galena production install. Copy to .env and fill in every CHANGE_ME:
#
#   cp deploy/.env.example deploy/.env
#
# deploy/.env is git-ignored. Never commit real values.
# Use URL-safe passwords (letters, digits, "-", "_", ".") because some of them
# are embedded in Postgres connection URLs.
#
# Optional AI features stay OFF unless you set them up: TOOLS_ENABLED,
# ROUTINES_ENABLED, PUSH_ENABLED and WEB_TOOLS_ENABLED all default to false.

# Public domain of this install, without scheme. Real install: chat.example.com.
# localhost keeps Caddy on its local CA so you can try the stack out.
GALENA_DOMAIN=localhost

# Contact address for the ACME account (Let's Encrypt reminders). Ignored for localhost.
ACME_EMAIL=CHANGE_ME@example.com

# Host ports Caddy publishes. Defaults are the standard web ports; the
# install test in work/T-0126-production-images-compose.md uses 18080/18443.
HTTP_PORT=80
HTTPS_PORT=443

# Server mode. The images ship no dev-only packages (no pino-pretty), so
# every install runs "production". A localhost trial keeps the console
# mailer through MAIL_ALLOW_CONSOLE_IN_PRODUCTION below (OTP codes go to
# the server log with a loud warning): scratch-only, never for a real
# install, which needs MAIL_TRANSPORT=smtp. Written by `./deploy/galena
# init` (NODE_ENV=production, console+opt-in for localhost).
NODE_ENV=production

# Superuser of the Postgres container. Only used inside the container and by
# deploy/postgres/init/10-create-databases.sql; apps use the users below.
POSTGRES_PASSWORD=CHANGE_ME

# Published image coordinates (ghcr.io/<owner>/galena-*), one release tag for
# all four images. postgres and ejabberd also build locally from deploy/ in
# the plain stack, but server and web must exist under this owner/tag.
IMAGE_OWNER=CHANGE_ME
IMAGE_TAG=CHANGE_ME

# User "galena" and database "galena": our server's database (pgvector enabled).
GALENA_DB_PASSWORD=CHANGE_ME

# User "ejabberd" and database "ejabberd": XMPP accounts, rosters, MUC and MAM.
EJABBERD_DB_PASSWORD=CHANGE_ME

# User "galena_archive": read-only role the server uses for message search.
# It can only SELECT ejabberd's message archive. Use a URL-safe password
# (letters and digits): it is placed inside a database URL.
GALENA_ARCHIVE_DB_PASSWORD=CHANGE_ME

# Password of the XMPP admin account. The ejabberd container registers it on
# first start; the server uses it for the admin API.
EJABBERD_ADMIN_PASSWORD=CHANGE_ME

# Shared HS256 secret for XMPP token login, at least 32 random bytes. The
# ejabberd container turns it into a JWK file at start and @galena/server signs
# short-lived JWTs with it. Generate one with e.g. "openssl rand -base64 48".
GALENA_XMPP_JWT_SECRET=CHANGE_ME_CHANGE_ME_CHANGE_ME_CHANGE_ME

# Secret Better Auth uses to sign sessions and encrypt data. Must be at least
# 32 characters. Generate one with: openssl rand -base64 32
BETTER_AUTH_SECRET=CHANGE_ME_CHANGE_ME_CHANGE_ME_CHANGE_ME

# Envelope-encryption master key for provider keys stored in
# provider_connections (Settings → Connections). Generate one with e.g.
# "openssl rand -base64 48". At least 32 characters. Changing it later makes
# every stored provider key undecryptable. Optional: without it the server
# still boots but provider-key and AI write routes answer 503.
GALENA_KEY_ENCRYPTION_KEY=CHANGE_ME_CHANGE_ME_CHANGE_ME_CHANGE_ME

# --- Optional: trusted proxy hops for the invite-link join limiter.
# --- Default 0 (socket address; proxy headers ignored). Behind one proxy
# --- (e.g. Caddy) set 1 so the per-IP join budget is per client, not global.
# TRUSTED_PROXY_HOPS=0

# --- Optional: LLM gateway (LiteLLM). Default OFF: leave both unset and the
# --- server boots without AI features (AI routes answer 503).
# Base URL of the LiteLLM proxy. The production stack has no LiteLLM service;
# point this at your own gateway when you have one.
# LITELLM_BASE_URL=https://llm.example.com
# Bearer token for the LiteLLM admin API. It normally looks like "sk-...".
# LITELLM_MASTER_KEY=sk-CHANGE_ME

# --- Optional: agent gateway. Default OFF. Needs the LiteLLM variables above
# --- plus GALENA_KEY_ENCRYPTION_KEY to do anything useful.
AGENT_GATEWAY_ENABLED=false

# --- Optional: action demo adapter. Default OFF, for testing only.
ACTION_DEMO_ENABLED=false

# --- Optional: runner hub (tunnel for approved AI runners). Default OFF.
# --- The hub is reachable only inside the install (never published); runners
# --- connect over Tailscale/WireGuard or an SSH tunnel to the host.
RUNNER_HUB_ENABLED=false

# --- Required: outgoing email. Galena signs people in with a one-time code
# --- sent by email, so a production server refuses to start without a mail
# --- transport (until T-0128, which adds the SMTP mailer, is merged).
# Mail transport: "smtp" (needs T-0128) or "console" (development only:
# prints OTP codes to the server log, never use for a real install).
MAIL_TRANSPORT=console
# SMTP provider host, e.g. smtp.resend.com, smtp.sendgrid.net,
# email-smtp.eu-west-1.amazonaws.com. Empty until T-0128.
SMTP_HOST=
# SMTP port. Default 587 (STARTTLS).
SMTP_PORT=587
# "true" for implicit TLS (usually port 465), "false" for STARTTLS (587).
SMTP_SECURE=false
# SMTP username, often "apikey" or the full sending address.
SMTP_USER=
# SMTP password or API key. Secret.
SMTP_PASSWORD=CHANGE_ME
# Sender shown on sign-in emails, e.g. Galena <no-reply@chat.example.com>.
MAIL_FROM=Galena <no-reply@localhost>
# Optional Reply-To header. Empty means no Reply-To.
MAIL_REPLY_TO=
# Development escape hatch only: "true" lets the console mailer run in
# production so a scratch install can boot before T-0128. Never enable on a
# real install: nobody could sign in (codes go to the server log).
MAIL_ALLOW_CONSOLE_IN_PRODUCTION=false

# --- Optional: push notifications. Default OFF. When on (PUSH_ENABLED=true),
# --- the server runs as an XEP-0114 component against ejabberd (mod_push);
# --- every browser needs Web Push over HTTPS, which the Caddy setup gives.
# --- `./galena init` generates the keys and secrets and asks for the
# --- contact address (or takes --push-subject/--no-push); `./galena doctor`
# --- checks the pieces. Until the wizard writes them, the PUSH_* lines are
# --- simply absent (missing = unset = push off): never write an empty value
# --- (KEY=), Compose renders it as an empty string and the server rejects
# --- empty strings at startup.
PUSH_ENABLED=false
# VAPID key pair the browsers subscribe against (generated by init with
# openssl; the public key is served to logged-in browsers, the private key
# is a secret). web-push format: public 87 chars, private 43 chars.
# PUSH_VAPID_PUBLIC_KEY=
# PUSH_VAPID_PRIVATE_KEY=
# Contact URI for the push services, e.g. mailto:admin@chat.example.com
# (init defaults it to mailto:<admin email>). Not a secret.
# PUSH_VAPID_SUBJECT=
# push.<this domain>: must equal the host the ejabberd entrypoint writes
# into the ejabberd_service listener (push-entrypoint.sh derives it from
# GALENA_DOMAIN, so this line needs no edit). Not a secret.
# PUSH_COMPONENT_JID=push.localhost
# Shared secret with ejabberd's ejabberd_service listener (must equal
# EJABBERD_MACRO_PUSH_COMPONENT_SECRET the ejabberd container sees).
# Secret: generated by init with `openssl rand -base64 32`.
# PUSH_COMPONENT_SECRET=
# Seals browser subscription keys at rest (AES-256-GCM, at least 32 chars).
# Secret: generated by init with `openssl rand -base64 48`. Backed up with
# the rest of the env file — losing it orphans every device (browsers must
# re-enable push).
# PUSH_STORAGE_KEY=

# --- Optional: server-side tools, routines and web tools. Default OFF.
TOOLS_ENABLED=false
ROUTINES_ENABLED=false
WEB_TOOLS_ENABLED=false

# --- Optional: GitHub App for the git proxy. Default OFF: leave all three
# --- unset and the server boots without git integration. All three must be
# --- set together.
# GITHUB_APP_ID=CHANGE_ME
# GITHUB_APP_PRIVATE_KEY=CHANGE_ME
# GITHUB_APP_INSTALLATION_ID=CHANGE_ME

# --- Storage safety (T-0151): where files live and what covers them. ---
# Attachments: ejabberd upload volume (`ejabberd-uploads`,
# /opt/ejabberd/upload). Stickers: sticker volume (`sticker-data`,
# STICKER_STORAGE_DIR=/data/stickers, fixed — never change it: a different
# value orphans previously uploaded stickers). GIFs: not stored (proxied;
# a sent GIF becomes a normal attachment). Voice: not built.
# `./galena backup` archives BOTH file volumes (uploads.tgz + stickers.tgz,
# mode 0600 with the rest); `./galena doctor` warns at 80% disk use and
# fails at 95%.
