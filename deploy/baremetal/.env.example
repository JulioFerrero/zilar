# Example environment for a bare-metal Galena install.
#
# Copy to /etc/galena/galena.env (mode 0600, owned by the galena user) and
# fill in every CHANGE_ME. This file is read by the systemd unit
# galena-server.service via EnvironmentFile= — systemd never prints these
# values to the journal.
#
# A production server refuses to start without a mail transport (Galena
# signs people in with a one-time code sent by email).

# Server mode. A localhost trial runs "development" (console mailer: OTP
# codes go to the server log); a real install runs "production" and needs
# MAIL_TRANSPORT=smtp with the SMTP_* settings below.
NODE_ENV=production

# Public base URL of this install (no trailing slash). The web app and
# Better Auth derive cookie scoping, CORS origins and invite links from it.
PUBLIC_URL=https://chat.example.com

# Postgres connection string for the galena user and database created by
# setup-postgres.sql. Use a URL-safe password (letters and digits).
DATABASE_URL=postgres://galena:CHANGE_ME@localhost:5432/galena

# Read-only role on the ejabberd archive for message search. Leave unset to
# disable search (GET /api/search answers 501 and the web hides it).
# XMPP_ARCHIVE_DATABASE_URL=postgres://galena_archive:CHANGE_ME@localhost:5432/ejabberd

# Secret Better Auth uses to sign sessions and encrypt data. At least 32
# characters. Generate one with: openssl rand -base64 32
BETTER_AUTH_SECRET=CHANGE_ME_CHANGE_ME_CHANGE_ME_CHANGE_ME

# Web origins allowed to call the API with cookies (comma-separated, at
# least one). Normally just the public URL.
WEB_ORIGINS=https://chat.example.com

# Admin HTTP API of the local ejabberd, and the admin account the server
# logs in as (registered by deploy/baremetal/ejabberd.yml defaults).
EJABBERD_API_URL=http://127.0.0.1:5280/api
EJABBERD_ADMIN_JID=admin@chat.example.com
# Password set with ejabberdctl register admin <host> <password>. Secret.
EJABBERD_ADMIN_PASSWORD=CHANGE_ME

# XMPP domains, matching hosts:/MUC host in deploy/baremetal/ejabberd.yml.
XMPP_DOMAIN=chat.example.com
XMPP_MUC_DOMAIN=rooms.chat.example.com
# Public WebSocket URL clients connect to (through Caddy/nginx below).
XMPP_WS_PUBLIC_URL=wss://chat.example.com/xmpp-ws/ws

# Shared HS256 secret for XMPP token login, at least 32 random bytes. Must
# match the jwt_key JWK on the ejabberd side (see the guide: derive the JWK
# with the same recipe as deploy/ejabberd/jwt-entrypoint.sh).
GALENA_XMPP_JWT_SECRET=CHANGE_ME_CHANGE_ME_CHANGE_ME_CHANGE_ME

# Envelope-encryption master key for provider keys (Settings →
# Connections). At least 32 characters; changing it later makes every
# stored provider key undecryptable. Optional: without it the server still
# boots but provider-key and AI write routes answer 503.
# GALENA_KEY_ENCRYPTION_KEY=CHANGE_ME_CHANGE_ME_CHANGE_ME_CHANGE_ME

# --- Outgoing email (required): sign-in codes are sent by email. ---
MAIL_TRANSPORT=smtp
SMTP_HOST=CHANGE_ME
SMTP_PORT=587
SMTP_SECURE=false
# SMTP_USER= (often "apikey" or the full sending address; leave unset for no auth)
# SMTP_PASSWORD= (secret)
MAIL_FROM=Galena <no-reply@chat.example.com>
# MAIL_REPLY_TO=

# --- Feature flags: all OFF unless you set them up. ---
AGENT_GATEWAY_ENABLED=false
ACTION_DEMO_ENABLED=false
RUNNER_HUB_ENABLED=false
PUSH_ENABLED=false
TOOLS_ENABLED=false
ROUTINES_ENABLED=false
WEB_TOOLS_ENABLED=false
